<%- include("templates/cabecera",{titulo:'Gana tu Ride Ags'}) %> 
<div class="loading"></div>
<div class="fondo"> </div>
<div class="contenido">
    <div class="titulo-sorteo rojo"><p id="corp"><%= titulo %></p></div>
    <div class="areaPremios">
       <%- include("templates/carrusel",{imagenes:activo.premios,id:activo._id}) %>  
    </div>
    <div class="costo" >Boleto $250 (5 numeros a elegir)</div>
    <%- include("templates/descripcionSorteo") %>



    <div class="areaBoletos">
        <div id="apartados"><p style="margin:0;">¿No sabes que números elegir?</p>
            <div class="Padre"><div id="generarNums" class="alAzar"></div></div>
        <!--      <i title="Seleccionar al azar los números que te falten" class="fa-solid fa-shuffle"></i>
              <img src="./img/azar628_color.png" alt="" width="80px"> -->
            <p>Da clic para elegirlos aleatoriamente</p>
        </div>

          <% function agregaCeros(n){
		        let maxCeros = activo.num_fin.toString().length+1;
                let nS = n.toString()
                return  '0'.repeat(maxCeros-nS.length)+nS
            }
            let estatus = {0:"libre",1:"apartado",2:"reservado",3:"comprado"}
            let boletos = Object.values(boletosObjeto);
            let cant = boletos.length
            let i=0
            %>
          <h4>De clic en tus 5 números para seleccionarlo manualmente</h4>
        <div id="boletos" class="boletos">
            <% while(i!=cant){ 
                let miEst = boletos[i].estatus;
            %> 
            <div id="boleto_<%= boletos[i]._id %>" class="boleto <%= estatus[miEst] %>">
                <div id="<%= boletos[i]._id %>"><%= agregaCeros(boletos[i].numero) %> </div>
            </div>
            <% i++; } %>
        </div>
    </div>
   
    <%- include("templates/footer") %>
</div>

<%- include("templates/datosCliente",{datosForm:[{e:'*Nombre:',c:['text','Nombre completo','nom']},{e:'*Telefono:',c:['tel','10 digitos','tel']}]  }) %>

<script src="js/alertasDialogos.js"></script>
<script src="js/metodos.js" ></script>
</body>
</html>