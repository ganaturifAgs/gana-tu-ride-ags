<%
 function agregaCeros(n,ceros){
            let nS = n.toString()
            return  '0'.repeat(ceros-nS.length)+nS
        }
let numsBoletos = ""
data.numeros.forEach(e=>{ numsBoletos+=agregaCeros(e,data.nuMax)+" - " })
%>
<div id="izquierda" class="lateral <%= data.estatus == 2 ? 'colorReservado':'colorPagado' %>" ><%= data.titulo %></div>
        <div class="central">
            <div id="arriba" class="centrales">
                <div class="imagen"> <img src="/img/logo_circulo.png" width="70px" alt=""></div>
                <div id="gana">GANA TU RIDE AGS</div>
            </div>
            <div id="medio" class="centrales">
                <span class="eti">BOLETO</span>
                <span id="misNumeros"><%= numsBoletos  %></span>
               
            </div>
            <div id="abajo" class="centrales">
                <div class="datos"><span class="eti">SORTEO:</span><span id="titulo"><%= data.titulo %></span></div>
                <div class="datos"><span class="eti">NOMBRE:</span><span id="nombre"><%= data.datos.nombre %></span></div>
                <div class="datos"><span class="eti">ESTADO:</span><span id="estado"><%= data.datos.estado %></span></div>
                <div class="datos"><span class="eti">ESTATUS:</span><span id="estatus" class="<%= data.estatus == 2 ? 'reservado':'pagado' %>"><%= data.estatus == 2 ? 'Reservado':'Pagado' %></span></div>
                <div class="datos"><span class="eti">F. COMPRA:</span><span id="fecha_comp"><%= data.fecha['1'] %></span></div>
                <div class="datos"><span class="eti">F. SORTEO:</span><span id="fecha_sorteo"><%= data.fecha_sorteo %></span></div>
                <div class="foto"><img id="foto" src="/img/sorteos/<%= data.sorteo %>/<%= data.foto %>"  width="150px"> </div>
            </div>
            <div id="qrcode" class="centrales">


            </div>
        </div>
    <div id="derecha" class="lateral <%= data.estatus == 2 ? 'colorReservado':'colorPagado' %>" ><%= data.titulo %></div>